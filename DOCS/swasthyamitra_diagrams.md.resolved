## 3.3 ER Diagram

```mermaid
erDiagram
    USER {
        string uid PK
        string email
        string name
        string phone
        string dob
        string gender
        double height
        double weight
        double goalWeight
        string goalType
        string activityLevel
        string dietaryPreference
        string allergies
        string avatarId
        boolean periodMode
    }

    FOOD_LOG {
        string logId PK
        string userId FK
        string foodName
        string barcode
        int calories
        double protein
        double carbs
        double fat
        string servingSize
        string mealType
        long timestamp
        string date
    }

    EXERCISE_LOG {
        string logId PK
        string userId FK
        string exerciseName
        int caloriesBurned
        int duration
        string intensity
        string source
        string targetMuscle
        string bodyPart
        long timestamp
        string date
    }

    STEP_SESSION {
        string id PK
        string userId FK
        long startTime
        long endTime
        int validatedSteps
        int rawSteps
        double totalDistanceMeters
        double averageStrideM
        double confidenceScore
        double caloriesBurned
        long walkingSeconds
        long runningSeconds
        double averagePace
    }

    MOOD_DATA {
        string date PK
        string userId FK
        string mood
        float intensity
        float energy
        string suggestion
        long timestamp
    }

    MEAL_PLAN {
        string date PK
        string userId FK
        string breakfast
        string lunch
        string snack
        string dinner
        string postWorkout
        long generatedAt
    }

    HYDRATION {
        string date PK
        string userId FK
        int totalMl
        int goalMl
    }

    SLEEP_LOG {
        string date PK
        string userId FK
        long sleepStart
        long sleepEnd
        int durationMinutes
        string quality
    }

    WEIGHT_LOG {
        string date PK
        string userId FK
        double weight
        long timestamp
    }

    RECOMMENDATION {
        string documentId PK
        string userId FK
        string type
        string mealTime
        int remainingCalories
        string message
        string status
        long createdAt
    }

    GAMIFICATION {
        string userId PK
        string lastActiveDate
        int streak
        int shields
        int steps
        int xp
        int level
        int totalWorkoutMinutes
    }

    DAILY_ACTIVITY {
        string date PK
        string userId FK
        int steps
        int calories
        string workout
    }

    EMERGENCY_CONTACT {
        string contactId PK
        string userId FK
        string name
        string phoneNumber
    }

    EMERGENCY_EVENT {
        string eventId PK
        string userId FK
        double latitude
        double longitude
        string reason
        int batteryPercentage
        long timestamp
    }

    DIET_FEEDBACK {
        string feedbackId PK
        string userId FK
        string mealName
        string mealType
        string action
        string reason
        long timestamp
    }

    USER ||--o{ FOOD_LOG : "logs meals"
    USER ||--o{ EXERCISE_LOG : "logs exercises"
    USER ||--o{ STEP_SESSION : "tracks steps"
    USER ||--o{ MOOD_DATA : "records mood"
    USER ||--o{ MEAL_PLAN : "receives diet plans"
    USER ||--o{ HYDRATION : "tracks water"
    USER ||--o{ SLEEP_LOG : "logs sleep"
    USER ||--o{ WEIGHT_LOG : "tracks weight"
    USER ||--o{ RECOMMENDATION : "gets recommendations"
    USER ||--|| GAMIFICATION : "has gamification data"
    USER ||--o{ DAILY_ACTIVITY : "has daily activity"
    USER ||--o{ EMERGENCY_CONTACT : "manages contacts"
    USER ||--o{ EMERGENCY_EVENT : "triggers SOS"
    USER ||--o{ DIET_FEEDBACK : "gives feedback"
```

