## 3.2 Class Diagrams

### 3.2.1 Core User & Authentication

```mermaid
%%{init: {'theme': 'dark'}}%%
classDiagram
    direction LR
    MainActivity --> LoginActivity
    LoginActivity --> SignupActivity
    LoginActivity --> ForgotPasswordActivity
    LoginActivity ..> FirebaseAuthHelper
    SignupActivity --> UserInfoActivity
    UserInfoActivity --> InsertGoalActivity
    InsertGoalActivity --> LifestyleActivity

    class MainActivity {
        +checkUserSession()
        +navigateToHomepage()
    }
    class LoginActivity {
        +loginUser(email, password)
        +validateInputs()
    }
    class SignupActivity {
        +registerUser()
        +saveUserData()
    }
    class ForgotPasswordActivity {
        +sendPasswordResetEmail(email)
    }
    class FirebaseAuthHelper {
        +getCurrentUserId() String
        +isLoggedIn() Boolean
    }
    class UserInfoActivity {
        +savePersonalData()
        +calculateBMI()
    }
    class InsertGoalActivity {
        +saveGoal(goalType)
    }
    class LifestyleActivity {
        +savePreferences()
        +saveActivityLevel()
    }
```

### 3.2.2 Health Profile System

```mermaid
%%{init: {'theme': 'dark'}}%%
classDiagram
    direction TB
    ProfileActivity --> AvatarCustomizationActivity
    ProfileActivity ..> AvatarManager
    ProfileActivity ..> CalorieCalculator
    WeightProgressActivity ..> WeightProjectionHelper

    class ProfileActivity {
        +loadUserProfile()
        +saveProfileChanges()
        +handleLogout()
    }
    class AvatarCustomizationActivity {
        +selectAvatar()
        +saveAvatar()
    }
    class AvatarManager {
        +getAvatarId() String
        +saveAvatarId(id)
    }
    class CalorieCalculator {
        +calculateBMR() Double
        +calculateTDEE() Double
        +getTargetCalories() Int
    }
    class WeightProgressActivity {
        +loadWeightHistory()
        +addWeightEntry()
    }
    class WeightProjectionHelper {
        +projectWeight()
        +plotWeightTrend()
    }
```

### 3.2.3 Activity Tracking System

```mermaid
%%{init: {'theme': 'dark'}}%%
classDiagram
    direction TB
    UnifiedStepTrackingService --> HybridStepValidator
    UnifiedStepTrackingService --> StepGpsValidator
    UnifiedStepTrackingService --> FirebaseStepSync
    HybridStepValidator ..> StepSession
    MapActivity --> TrackingService

    class UnifiedStepTrackingService {
        +startTracking()
        +stopTracking()
        +onSensorChanged()
    }
    class HybridStepValidator {
        +validateSteps() Int
        +anomalyDetection()
    }
    class StepGpsValidator {
        +validateWithGPS()
        +getConfidenceScore()
    }
    class FirebaseStepSync {
        +syncStepsToFirebase()
        +fetchTodaySteps()
    }
    class StepSession {
        +validatedSteps : Int
        +confidenceScore : Double
        +caloriesBurned : Double
    }
    class MapActivity {
        +displayRoute()
        +startTracking()
    }
    class TrackingService {
        +startLocationUpdates()
        +calculateDistance()
    }
    class StepCounterService {
        +onSensorChanged()
        +broadcastSteps()
    }
    class SleepTrackerActivity {
        +logSleep()
        +displaySleepHistory()
    }
    class WaterGoalCalculator {
        +calculateWaterGoal() Int
    }
```

### 3.2.4 AI Diet & Exercise Plan System

```mermaid
%%{init: {'theme': 'dark'}}%%
classDiagram
    direction TB
    AIDietPlanService --> MealPlan
    MealPlan --> MealRec
    AIExerciseRecommendationService --> ExerciseRec
    AIMoodRecommendationService ..> LocalMoodAnalyzer

    class AIDietPlanService {
        +generateSmartDietPlan() MealPlan
        +buildPrompt() String
        +callGeminiAPI() String
        +detectPlateau()
    }
    class MealPlan {
        +breakfast : MealRec
        +lunch : MealRec
        +dinner : MealRec
    }
    class MealRec {
        +name : String
        +calories : Int
        +protein : Double
    }
    class AIExerciseRecommendationService {
        +getExerciseRecommendation()
        +loadSmartExerciseSample()
    }
    class ExerciseRec {
        +name : String
        +sets : Int
        +calories : Int
    }
    class AICoachMessageService {
        +getCoachMessage()
        +calculateActivityScore()
    }
    class AIMoodRecommendationService {
        +getMoodRecommendation()
    }
    class AIPantryService {
        +generateRecipe(imageUri)
    }
    class LocalMoodAnalyzer {
        +analyzeMood() Map
    }
```

### 3.2.5 Gamification, Reports & Emergency SOS

```mermaid
%%{init: {'theme': 'dark'}}%%
classDiagram
    direction TB
    GamificationActivity --> GamificationRepository
    GamificationActivity --> XPManager
    GamificationRepository --> FitnessData
    FitnessData --> ShieldInstance
    SOSManager --> EmergencyContactManager

    class GamificationActivity {
        +syncWithFirebase()
        +checkLevelUp()
    }
    class GamificationRepository {
        +validateAndFixStreak() FitnessData
        +checkIn()
        +saveData()
    }
    class FitnessData {
        +streak : Int
        +xp : Int
        +level : Int
    }
    class ShieldInstance {
        +type : ShieldType
        +expiresAt : Long
    }
    class XPManager {
        +awardXP()
        +calculateLevel() Int
    }
    class BadgesActivity {
        +loadBadges()
        +displayBadges()
    }
    class SOSManager {
        +sendSOS()
        +sendSMS()
    }
    class EmergencyContactManager {
        +getContacts() List
    }
    class DetailedReportActivity {
        +loadReportData()
        +generateCharts()
    }
    class InsightsRepository {
        +getWeeklyInsights()
    }
```

