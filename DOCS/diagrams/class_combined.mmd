---
config:
  theme: default
  themeVariables:
    fontSize: 14px
    classText: "#000000"
  flowchart:
    rankSpacing: 30
    nodeSpacing: 20
---
%% Unified class diagram – SwasthyaMitra (compact vertical A4)

classDiagram
    direction LR

    %% ══ AUTH ══
    class MainActivity { +checkUserSession() }
    class LoginActivity { +loginUser() }
    class SignupActivity { +registerUser() }
    class ForgotPasswordActivity { +sendResetEmail() }
    class FirebaseAuthHelper { +getCurrentUserId()  +isLoggedIn() }
    class UserInfoActivity { +savePersonalData() }
    class InsertGoalActivity { +saveGoal() }
    class LifestyleActivity { +savePreferences() }

    MainActivity --> LoginActivity
    LoginActivity --> SignupActivity
    LoginActivity --> ForgotPasswordActivity
    LoginActivity ..> FirebaseAuthHelper
    SignupActivity --> UserInfoActivity
    UserInfoActivity --> InsertGoalActivity
    InsertGoalActivity --> LifestyleActivity

    %% ══ HUB ══
    class Homepage { +loadDashboard() }
    LifestyleActivity --> Homepage : onboarding

    Homepage --> ProfileActivity
    Homepage --> UnifiedStepTrackingService
    Homepage --> GamificationActivity

    %% ══ PROFILE ══
    class ProfileActivity { +loadUserProfile()  +handleLogout() }
    class AvatarCustomizationActivity { +selectAvatar() }
    class AvatarManager { +getAvatarId() }
    class CalorieCalculator { +calculateBMR()  +calculateTDEE()  +getTargetCalories() }
    class WeightProgressActivity { +loadWeightHistory() }
    class WeightProjectionHelper { +projectWeight() }
    class WaterGoalCalculator { +calculateWaterGoal() }

    ProfileActivity --> AvatarCustomizationActivity
    ProfileActivity ..> AvatarManager
    ProfileActivity ..> CalorieCalculator
    ProfileActivity --> WeightProgressActivity
    WeightProgressActivity ..> WeightProjectionHelper
    CalorieCalculator ..> WaterGoalCalculator

    %% ══ AI SERVICES ══
    class AIDietPlanService { +generateSmartDietPlan()  +callGeminiAPI() }
    class MealPlan { +breakfast  +lunch  +dinner }
    class MealRec { +name  +calories  +protein }
    class AIExerciseRecommendationService { +getExerciseRecommendation() }
    class ExerciseRec { +name  +sets  +calories }
    class AICoachMessageService { +getCoachMessage() }
    class AIMoodRecommendationService { +getMoodRecommendation() }
    class AIPantryService { +generateRecipe() }
    class LocalMoodAnalyzer { +analyzeMood() }

    ProfileActivity ..> AIDietPlanService : diet
    AIDietPlanService ..> CalorieCalculator : TDEE
    AIDietPlanService --> MealPlan
    MealPlan --> MealRec
    ProfileActivity ..> AIExerciseRecommendationService : exercise
    AIExerciseRecommendationService --> ExerciseRec
    ProfileActivity ..> AIMoodRecommendationService : mood
    AIMoodRecommendationService ..> LocalMoodAnalyzer
    ProfileActivity ..> AIPantryService : pantry

    %% ══ TRACKING ══
    class UnifiedStepTrackingService { +startTracking()  +stopTracking() }
    class HybridStepValidator { +validateSteps() }
    class StepGpsValidator { +validateWithGPS() }
    class FirebaseStepSync { +syncStepsToFirebase() }
    class StepSession { +validatedSteps  +confidenceScore  +caloriesBurned }
    class MapActivity { +displayRoute() }
    class TrackingService { +startLocationUpdates() }
    class StepCounterService { +onSensorChanged() }
    class SleepTrackerActivity { +logSleep() }

    UnifiedStepTrackingService --> HybridStepValidator
    UnifiedStepTrackingService --> StepGpsValidator
    UnifiedStepTrackingService --> FirebaseStepSync
    UnifiedStepTrackingService ..> StepCounterService : sensor
    UnifiedStepTrackingService ..> MapActivity
    UnifiedStepTrackingService ..> SleepTrackerActivity
    MapActivity --> TrackingService
    HybridStepValidator ..> StepSession

    %% ══ GAMIFICATION & SAFETY ══
    class GamificationActivity { +syncWithFirebase() }
    class GamificationRepository { +validateAndFixStreak()  +checkIn() }
    class FitnessData { +streak  +shields  +steps  +totalWorkoutMinutes }
    class ShieldInstance { +type  +expiresAt }
    class BadgesActivity { +loadRealStageData() }
    class SOSManager { +sendSOS()  +sendSMS() }
    class EmergencyContactManager { +getContacts() }
    class DetailedReportActivity { +loadReportData() }
    class InsightsRepository { +getWeeklyInsights() }

    GamificationActivity --> GamificationRepository
    GamificationActivity --> BadgesActivity
    GamificationActivity ..> AICoachMessageService : coach
    GamificationActivity ..> DetailedReportActivity : reports
    GamificationRepository --> FitnessData
    FitnessData --> ShieldInstance
    SOSManager --> EmergencyContactManager
    SOSManager ..> TrackingService : GPS

    %% ══ CROSS-MODULE ══
    FirebaseStepSync ..> GamificationRepository : steps
    StepSession ..> FitnessData : daily
    AICoachMessageService ..> FitnessData : score
    DetailedReportActivity ..> FitnessData : report
    DetailedReportActivity ..> InsightsRepository
    UnifiedStepTrackingService ..> SOSManager : safety
